# Model (DashScope OpenAI-compatible endpoint in the current project)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
CHAT_MODEL=qwen3.5-plus
# 可选：饮食图片/文本识别模型，未设置时复用 CHAT_MODEL。
FOOD_ANALYSIS_MODEL=

# TCM PDF RAG. The index is built from pages 8-126 of
# backend/rag/了不起的中医养生妙招（全二册）.pdf.
TCM_RAG_EMBEDDING_MODEL=text-embedding-v1
TCM_RAG_COLLECTION=tcm_wellness_pdf_v1
# Leave empty to persist under backend/rag/chroma/tcm_wellness.
TCM_RAG_PERSIST_DIRECTORY=
# Hybrid retrieval: two query variants × vector/BM25 recall, then DashScope rerank.
TCM_RAG_VECTOR_CANDIDATES=8
TCM_RAG_BM25_CANDIDATES=8
TCM_RAG_RERANK_CANDIDATES=12
TCM_RAG_RERANK_MODEL=qwen3-rerank
TCM_RAG_ENABLE_RERANK=true
# Ragas batch evaluation. Start with 10 records and concurrency 1-2 to control cost.
TCM_RAG_EVAL_CONCURRENCY=2
# MinerU defaults to its free flash parsing mode. Set this only when using its
# precision mode and a valid MinerU token.
MINERU_TOKEN=

# Optional Tavily web search tool
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# Optional AMap MCP Server. Keep the key server-side only.
# When no user-authorized address is supplied, the development mock is used.
AMAP_MAPS_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp
DEFAULT_ACTIVITY_LOCATION=北京来广营地铁站

# Optional MD2Card HTTP API. The key stays on the server and is sent as x-api-key.
MD2CARD_API_KEY=
# MD2CARD_API_URL=https://md2card.cn/api/generate

# `memory` is only for local development; production must use `postgres`.
MEMORY_BACKEND=memory
DATABASE_URL=postgresql://user:password@localhost:5432/personal_fitness
AGENT_RECURSION_LIMIT=10
SUMMARY_TRIGGER_TOKENS=4000
SUMMARY_MESSAGES_TO_KEEP=6

# Docker Compose PostgreSQL settings (local development defaults)
POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness_dev_password
POSTGRES_DB=personal_fitness

OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
