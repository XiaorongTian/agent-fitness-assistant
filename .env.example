# Model (DashScope OpenAI-compatible endpoint in the current project)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
CHAT_MODEL=qwen3.5-plus

# Optional Tavily web search tool
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# `memory` is only for local development; production must use `postgres`.
MEMORY_BACKEND=memory
DATABASE_URL=postgresql://user:password@localhost:5432/personal_fitness

# Docker Compose PostgreSQL settings (local development defaults)
POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness_dev_password
POSTGRES_DB=personal_fitness

OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
